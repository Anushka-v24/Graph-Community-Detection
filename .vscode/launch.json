{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug stats",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/stats_debug",
      "args": ["data/lfr_1k.edges"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build (debug)"
    }
  ]
}
